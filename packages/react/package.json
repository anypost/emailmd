{
  "name": "@emailmd/react",
  "version": "0.1.0",
  "description": "React hooks and components for emailmd — live email preview and a full markdown email builder.",
  "keywords": [
    "email",
    "markdown",
    "react",
    "html-email",
    "email-template",
    "email-builder",
    "preview",
    "emailmd"
  ],
  "license": "MIT",
  "author": "Dan Stevens",
  "homepage": "https://emailmd.dev",
  "repository": "github:anypost/emailmd",
  "bugs": "https://github.com/anypost/emailmd/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "rm -f LICENSE && cp ../../LICENSE .",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "emailmd": ">=0.6.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "emailmd": "*",
    "jsdom": "^26.0.0",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "react-colorful": "^5.7.0"
  }
}
